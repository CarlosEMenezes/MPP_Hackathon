# TMDB v4 "API Read Access Token" (https://www.themoviedb.org/settings/api)
TMDB_TOKEN=
# Secret used to bind/sign MPP challenges & receipts: openssl rand -hex 32
MPP_SECRET_KEY=
# Wallet address that receives payments (testnet wallet first, your own mainnet wallet later)
MPP_RECIPIENT=
# true = Tempo testnet (Moderato, play money); false = Tempo mainnet (real pathUSD)
MPP_TESTNET=true
PORT=4242
# Public base URL once deployed (used in llms.txt / openapi docs links)
PUBLIC_URL=
